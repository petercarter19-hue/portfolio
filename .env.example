ANTHROPIC_API_KEY=replace_with_your_key
AZURE_SQL_CONNECTIONSTRING=Server=tcp:replace.database.windows.net,1433;Database=replace;UID=replace;PWD=replace;Encrypt=yes;TrustServerCertificate=no;
FLASK_DEBUG=false
PORT=5000

# Local development only. Never enable this in production.
PEERSLATE_ALLOW_DEV_IDENTITY=false
PEERSLATE_DEV_USER_KEY=test-user-1
PEERSLATE_ENABLE_DB_TEST_ROUTES=false
PEERSLATE_DATABASE_UI_ENABLED=false
PEERSLATE_LIVING_RESUME_DB_ENABLED=false

# Backend-only Slice J1: derived private Journal read (usp_ListJournalMomentsForOwner)
# and one-step idempotent Save Moment (usp_SaveMomentForOwner). No template, CSS, JS,
# or navigation depends on this yet. Keep off until the visual gate + migration pass.
PEERSLATE_JOURNAL_ENABLED=false

# PS-ASK-PETE-AI-001: default-off grounded Ask Pete. When true, POST /api/chat
# answers only from the server-side approved source manifest
# (data/ai_sources/ask_pete_public_v1.json), with citation and quality
# validation, instead of the legacy knowledge-file prompt. Unlike the other
# flags here it does not open a new route — /api/chat is already public — it
# replaces how an existing public route answers, and every question it answers
# is a paid model call. Keep off through merge and deployment; enablement is a
# separate PS-OPS-001 release decision, not a config change.
PEERSLATE_ASK_PETE_GROUNDED_ENABLED=false

# PS-ASK-PETE-DIRECT-001: default-off private recruiter-question path — the
# consent-first form inside Ask Pete's handoff card, POST
# /api/ask-pete/direct-question, and the owner-only inbox at
# /owner/ask-pete-inbox. Setting this to true is NOT enough to reach any of
# it: ask_pete_direct_routes.py is deliberately left UNREGISTERED until its
# recorded registration leg (app.py belongs to another lane), so the routes do
# not exist at run time no matter what this value is. The flag is checked with
# `is True`, so only a real boolean enables it.
#
# Two things must also be true before turning it on:
#   - PEERSLATE_OWNER_USER_KEYS must name EXACTLY ONE user key. That key is
#     the member questions are addressed to and the identity that opens the
#     inbox. Zero keys, more than one, or an email-only owner allowlist leaves
#     the path honestly unavailable (every send answers 503) rather than
#     guessing a recipient.
#   - The migration PS-ASK-PETE-DIRECT-001 must be gated and applied
#     (see docs/initiatives/PS-ASK-PETE-DIRECT-001/README.md).
# The consent copy states only what actually happens today, so it needs no
# reconciliation before enablement: nothing expires or is deleted on a
# timetable, and the copy says so. If an automated retention leg ever lands,
# strengthen the copy in that same change - never ahead of it.
# Enablement is Pete's decision, not a config change anyone else makes.
PEERSLATE_ASK_PETE_DIRECT_ENABLED=false

# PS-WORKSHOP-001: default-off protected private knowledge base (Workshop /
# My Information), GET /app/workshop. Slice W1 wires the page to the real
# owner-scoped knowledge store (services/knowledge_service.py) and adds
# direct entry (add/edit/archive/restore/delete). No AI call or session flow
# exists yet. Keep off through merge and deployment; enablement is a
# separate, later owner decision.
PEERSLATE_WORKSHOP_ENABLED=false

# Local development only. When true, GET /app/workshop renders a fixed
# checkpoint fixture instead of the real database-backed store, so a local
# preview can show a populated library (or, with ?_dev_state=empty, the
# first-run empty state) without a database connection. Never enable this in
# production; production-path code never consults it when false.
PEERSLATE_WORKSHOP_DEV_FIXTURE=false

# PS-WORKSHOP-001 W2a: default-off sub-flag (under PEERSLATE_WORKSHOP_ENABLED
# above) for the "Work on Something" opening, four doors, focused-question
# session, and honest AI-unavailable/holding states. No real AI call exists
# yet. When off, every /app/workshop/work/* route 404s neutrally before any
# identity resolution and the mode tab keeps its "Coming later" pill. Keep
# off through merge and deployment; enablement is a separate owner decision.
PEERSLATE_WORKSHOP_SESSION_ENABLED=false

# PS-OPPSLATE-001: default-off Opportunity Slate room, GET /opportunity-slate.
# Slice OS-1 delivers role intake (paste/type only), Review Source, the
# member's own manual wording correction, and checkpoint 1 of 2. Signed-in
# members get an owner-scoped ephemeral working session in Azure SQL;
# anonymous visitors get a truthful public session held in their own browser
# with a signed context token, and never reach a database procedure. No AI
# call exists on this surface yet. When off, every /opportunity-slate route
# 404s neutrally before any identity resolution. The route is PUBLIC when
# enabled, so turning it on is a PS-OPS-001 Launch decision, not a casual
# config change. Keep off through merge and deployment.
PEERSLATE_OPPORTUNITY_SLATE_ENABLED=false
PEERSLATE_OPPORTUNITY_SLATE_V2_ENABLED=false

# Optional. Signs the context token that carries an anonymous visitor's
# Opportunity Slate working state in their own browser session — never a
# database, never a cookie shared between visitors. If unset, app.py derives
# a deterministic key from ANTHROPIC_API_KEY (the same fallback idiom as
# INTERVIEW_CONTEXT_SIGNING_KEY), so this is safe to leave unset. Set it
# explicitly for stronger signing isolation.
PEERSLATE_OPPSLATE_CONTEXT_SIGNING_KEY=

# Opportunity Slate daily AI-call ceiling for the anonymous public mode
# (spend guard). LIVE AS OF SLICE OS-2 — this value is read on every
# anonymous AI request and refuses the call when it is spent.
#
# 0 (the default) means anonymous visitors get NO AI at all. The public
# screens still work end to end: pasting, reading, correcting, confirming,
# and navigating are unchanged, and the two AI steps refuse with honest copy
# rather than a broken page. At 0 that copy says the preview's AI budget was
# never opened; it says a daily limit was reached only when a real ceiling
# was set and is genuinely spent. Turning anonymous AI on is a deliberate
# spending decision, which is why it fails closed rather than defaulting to
# a number someone has to remember to lower.
#
# Changing this value requires an app restart. app.py reads it from the
# environment once at import; nothing mutates it at runtime.
#
# Three things to know before setting a number:
#   * It is PER WORKER PROCESS. There is no shared counter store in this
#     runtime, so under Gunicorn with N workers the effective ceiling is up
#     to N times this value. The PEERSLATE_OPPORTUNITY_SLATE_ENABLED flag
#     remains the real stop control.
#   * One unit of budget permits up to TWO provider requests, not one. The
#     guard reserves before the call, and the service allows a single retry
#     after a transient provider failure (MAX_PROVIDER_RETRIES = 1). The
#     worst-case daily provider spend is therefore
#         2 x (worker processes) x (this value)
#     requests. Size the number against that, not against this value alone.
#   * Measured cost per call at the models slice OS-2 selected, on a
#     full-length role description: about US$0.01 for the wording review and
#     about US$0.02-0.03 for the statement interpretation. A visitor who runs
#     the whole flow once costs roughly US$0.04, and the worst case above is
#     the figure to multiply. The recorded model trial these numbers come
#     from is in
#     docs/initiatives/PS-OPPORTUNITY-SLATE-001/OS-2_COMPLETION_REPORT.md.
PEERSLATE_OPPSLATE_DAILY_AI_CEILING=0

# PS-OPPSLATE-001 slice OS-6, all optional (sane defaults below). Bounds for
# the signed-in-only document upload and public-link import routes. Every
# one is read once by services/opportunity_source_intake_service.py; no
# secret or credential lives here — the guarded outbound fetch needs none.
#   OPPSLATE_UPLOAD_MAX_BYTES              default 15728640 (15 MB)
#   OPPSLATE_UPLOAD_MAX_PDF_PAGES          default 400
#   OPPSLATE_IMPORT_MAX_BYTES              default 5242880 (5 MB)
#   OPPSLATE_IMPORT_CONNECT_TIMEOUT_SECONDS default 5
#   OPPSLATE_IMPORT_TOTAL_TIMEOUT_SECONDS   default 10

# Optional. Signs the Flask session cookie the anonymous Workshop public
# preview uses to remember one visitor's own add/edit/archive/restore/delete
# actions for their browser session only (services/workshop_demo_library.py)
# — never a database. If unset, app.py derives a deterministic key from
# ANTHROPIC_API_KEY instead (same fallback idiom as
# INTERVIEW_CONTEXT_SIGNING_KEY), so this is safe to leave unset. Set it
# explicitly for stronger session-signing isolation in production.
PEERSLATE_SESSION_SECRET_KEY=

# Real owner-authored Community public pilot. Keep false until the protected
# migration, Candidate proof, production deployment, and explicit enablement.
PEERSLATE_COMMUNITY_PUBLIC_PILOT_ENABLED=false
# Use a dedicated random server secret in production. No Community content is
# placed in this value; it signs finite, content-free Feed cursors only.
PEERSLATE_COMMUNITY_SIGNING_KEY=

# Fail closed: Azure hosting alone does not make identity headers trustworthy.
# Enable only after Easy Auth is configured and direct-header bypass tests pass.
PEERSLATE_TRUST_EASYAUTH_HEADERS=false

# Owner-only Control Room allowlist (/owner/control-room). Comma or space
# separated. Both empty => the Control Room is inaccessible to everyone
# (fail-closed). Set at least one to grant yourself access.
#   - PEERSLATE_OWNER_EMAILS matches the server-resolved sign-in email
#     (case-insensitive). Easiest to set: use the email you sign in with.
#   - PEERSLATE_OWNER_USER_KEYS matches the opaque identity.user_key exactly.
#     For LOCAL dev with PEERSLATE_ALLOW_DEV_IDENTITY=true, that key is the
#     PEERSLATE_DEV_USER_KEY value below (e.g. test-user-1).
PEERSLATE_OWNER_EMAILS=
PEERSLATE_OWNER_USER_KEYS=

# Control Room Tier 1 (optional): live Azure DevOps sync — branch tips, main
# commits, active/completed PRs, pipeline runs, and deployed-vs-main drift.
# All four must be set to activate it; leave any one blank to keep it off
# (the dashboard works fully without it and says "not configured").
# The PAT must be scoped to READ ONLY: Code (Read) + Build (Read). Set an
# expiry. Create and set this yourself — never share the value with an agent.
PEERSLATE_ADO_ORG_URL=https://dev.azure.com/peerslate19
PEERSLATE_ADO_PROJECT=portfolio-site
PEERSLATE_ADO_REPO=portfolio-site
PEERSLATE_ADO_READ_PAT=

# Private Photo Capture backend. Keep the feature off until schema, Azure,
# accepted experience, and signed-in production verification all pass.
CAPTURE_PHOTO_ENABLED=false
# Synthetic-owner lifecycle proof. Keep the ordinary flag above false. The
# proof flag fails closed unless exactly two server-resolved internal user keys
# and a future UTC expiry no more than two hours away are configured. Values
# belong only in the approved secure operator path; never commit real keys.
CAPTURE_PHOTO_LIFECYCLE_PROOF_ENABLED=false
CAPTURE_PHOTO_LIFECYCLE_PROOF_USER_KEYS=
CAPTURE_PHOTO_LIFECYCLE_PROOF_EXPIRES_AT_UTC=
CAPTURE_PHOTO_LIFECYCLE_PROOF_RUN_ID=
CAPTURE_MEDIA_BLOB_ACCOUNT_URL=https://replace.blob.core.windows.net
CAPTURE_MEDIA_BLOB_CONTAINER=peerslate-private-capture-media
CAPTURE_PHOTO_MAX_BYTES=10485760
CAPTURE_PHOTO_MAX_PIXELS=20000000
CAPTURE_PHOTO_MAX_EDGE=8192
CAPTURE_PHOTO_DERIVATIVE_MAX_EDGE=2400

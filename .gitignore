# .gitignore - Tells Git which files and folders to never upload to GitHub.

# Environment files
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Local AI/tool settings
.claude/settings.local.json

# Local design reference material (not app code)
Design ideas/

# Local scratch/preview material (not app code)
tmp/

# Stray sandbox test artifact (safe to delete)
.__cptest

# Control Room build-time snapshot: generated fresh by the Azure pipeline
# (scripts/generate_control_room_snapshot.py) before packaging. Never commit
# the generated file itself; only the generator script is tracked.
control_room_snapshot.json

# Public-safe release identity: generated fresh by the Azure pipeline before
# packaging. Never commit a locally generated identity.
release_identity.json

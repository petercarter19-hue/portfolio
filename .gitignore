# .gitignore - Tells Git which files and folders to never upload to GitHub.

# Environment files
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Local AI/tool settings
.claude/settings.local.json

# .gitignore - Tells Git which files and folders to NEVER upload to GitHub

# Virtual environment - this is machine-specific, never share it
venv/
.venv/

# Python compiled files - auto-generated, not needed on GitHub
__pycache__/
*.pyc
*.pyo

# Mac system files - hidden files macOS creates automatically, not part of your project
.DS_Store

# Environment variables file - will hold secret API keys later, never share this
.env

# VS Code settings - optional, personal to your machine
.vscode/
